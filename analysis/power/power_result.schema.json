{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity-aware post-route power result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "measurement",
    "physical_context",
    "annotation_evidence",
    "power_w",
    "energy"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "status": { "enum": ["measured", "validation_only"] },
    "measurement": {
      "type": "object",
      "required": [
        "kind",
        "benchmark",
        "benchmark_result",
        "vcd",
        "scope",
        "duration_ns",
        "transactions",
        "vcd_window"
      ],
      "properties": {
        "kind": {
          "enum": ["warm_attention", "idle_warm_window", "validation_only"]
        },
        "benchmark": { "type": ["string", "null"] },
        "benchmark_result": { "type": ["string", "null"] },
        "vcd": { "type": "string" },
        "scope": { "type": "string" },
        "requested_scope": { "type": "string" },
        "duration_ns": { "type": "number", "exclusiveMinimum": 0 },
        "transactions": { "type": "integer", "minimum": 0 },
        "vcd_window": {
          "type": "object",
          "required": [
            "timescale",
            "first_timestamp",
            "last_timestamp",
            "first_time_ns",
            "last_time_ns",
            "duration_ns",
            "verified_against_benchmark"
          ],
          "properties": {
            "timescale": { "type": "string" },
            "first_timestamp": { "type": "integer", "minimum": 0 },
            "last_timestamp": { "type": "integer", "minimum": 1 },
            "first_time_ns": { "type": "number", "minimum": 0 },
            "last_time_ns": { "type": "number", "exclusiveMinimum": 0 },
            "duration_ns": { "type": "number", "exclusiveMinimum": 0 },
            "verified_against_benchmark": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "physical_context": {
      "type": "object",
      "required": ["corner", "clock_period_ns", "artifacts", "tool"],
      "properties": {
        "corner": { "const": "nom_tt_025C_1v80" },
        "clock_period_ns": { "const": 100 },
        "artifacts": { "type": "object" },
        "tool": {
          "type": "object",
          "required": [
            "librelane_version",
            "container_image",
            "openroad_command",
            "report_power_digits"
          ],
          "properties": {
            "librelane_version": { "type": "string" },
            "container_image": { "type": "string" },
            "openroad_command": { "type": "string" },
            "report_power_digits": { "const": 9 }
          }
        }
      }
    },
    "annotation_evidence": {
      "type": "object",
      "required": [
        "source",
        "report",
        "vcd_reported",
        "annotated_pin_count",
        "unannotated_pin_count",
        "annotated_pin_coverage_percent",
        "scope_signal_count"
      ],
      "properties": {
        "source": { "const": "VCD" },
        "report": { "type": "string" },
        "vcd_reported": { "const": true },
        "annotated_pin_count": { "type": "integer", "minimum": 1 },
        "unannotated_pin_count": { "type": ["integer", "null"], "minimum": 0 },
        "annotated_pin_coverage_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "scope_signal_count": { "type": "integer", "minimum": 1 }
      }
    },
    "power_w": {
      "type": ["object", "null"],
      "required": ["internal", "switching", "leakage", "total"],
      "properties": {
        "internal": { "type": "number", "minimum": 0 },
        "switching": { "type": "number", "minimum": 0 },
        "leakage": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      }
    },
    "energy": {
      "type": ["object", "null"],
      "required": ["window_j", "per_attention_nj"],
      "properties": {
        "window_j": { "type": "number", "minimum": 0 },
        "per_attention_nj": { "type": "number", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "measured" } } },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "kind": { "enum": ["warm_attention", "idle_warm_window"] },
              "benchmark": { "type": "string" },
              "benchmark_result": { "type": "string" },
              "vcd_window": {
                "properties": { "verified_against_benchmark": { "const": true } }
              }
            }
          },
          "power_w": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "measured" },
          "measurement": {
            "properties": { "kind": { "const": "warm_attention" } }
          }
        },
        "required": ["status", "measurement"]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": { "transactions": { "minimum": 1 } }
          },
          "energy": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "measurement": {
            "properties": { "kind": { "const": "idle_warm_window" } }
          }
        }
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": { "transactions": { "const": 0 } }
          },
          "energy": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "validation_only" } } },
      "then": {
        "properties": {
          "power_w": { "type": "null" },
          "energy": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
